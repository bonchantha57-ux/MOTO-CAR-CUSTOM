{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*", "../frontend/src/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": ["**/*.ts", "**/*.d.ts", "**/*.vue"]
}
